# Copy to .env for local development. Use a rotated secret; never commit .env.
LIVEKIT_URL=wss://your-livekit-host
LIVEKIT_API_KEY=replace-with-api-key
LIVEKIT_API_SECRET=replace-with-new-secret

# Subscription verification. Leave blank until the store accounts are configured.
# Prices are never configured here; the apps read them from Apple and Google.
SHELFA_GOOGLE_PACKAGE_NAME=com.shelfa
SHELFA_GOOGLE_SERVICE_ACCOUNT_FILE=
SHELFA_GOOGLE_PUBSUB_AUDIENCE=
SHELFA_GOOGLE_PUBSUB_SERVICE_ACCOUNT=
SHELFA_GOOGLE_PUBSUB_VERIFICATION_TOKEN=
SHELFA_APPLE_BUNDLE_ID=com.shelfa
SHELFA_APPLE_ISSUER_ID=
SHELFA_APPLE_KEY_ID=
SHELFA_APPLE_PRIVATE_KEY_PATH=
SHELFA_APPLE_APP_APPLE_ID=
SHELFA_APPLE_ROOT_CERTIFICATES_DIR=
SHELFA_APPLE_ALLOW_SANDBOX=true
SHELFA_APPLE_ENABLE_ONLINE_CHECKS=true
